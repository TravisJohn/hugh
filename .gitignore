# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# database backups (contain real data — never commit)
/backups

# standalone pitch decks / slides — kept locally, not part of the app
/presentation/
/presentation-story/
/HUGH_PRESENTATION.md

# local scratch / analysis artifacts — kept locally, not part of the app
/LEARNING_POINTS.md
/case-analysis.html
/docs/reports/

# architecture dashboard — generated at build (predev/prebuild)
/lib/architecture/data.generated.json
/public/admin-architecture/

# Warm Start (Stage A) — session-continuity hooks and their ledger. Decided
# 2026-08-04 that this belongs in a separate tooling repo, not in the app, so
# it stays local. Unanchored .starship/ so nested copies are caught too.
.starship/
/.claude/
/scripts/warm-start/
/warm-start-plan.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# Supabase CLI scratch
supabase/.temp/

# Python bytecode from scripts/
__pycache__/
*.pyc

# Reference-pack authoring cache: other publishers' page text, never committed
.pack-cache/
